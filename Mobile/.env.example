# Copiá este archivo como ".env" y llenalo con los datos de tu proyecto de Firebase.
# El archivo .env NO se sube a GitHub (está en .gitignore).
EXPO_PUBLIC_FB_API_KEY=
EXPO_PUBLIC_FB_AUTH_DOMAIN=
EXPO_PUBLIC_FB_PROJECT_ID=
EXPO_PUBLIC_FB_STORAGE_BUCKET=
EXPO_PUBLIC_FB_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FB_APP_ID=
# Google: el "ID de cliente web" sale en Firebase > Authentication > Google > Configuración del SDK web
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Opcional (solo para Google dentro del celular)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
